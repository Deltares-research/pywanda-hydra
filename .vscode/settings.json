{
  "notebook.formatOnSave.enabled": true,
  "notebook.defaultFormatter": "charliermarsh.ruff",
  "ruff.enable": true,
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  "ruff.importStrategy": "fromEnvironment",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[jupyter]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "flake8.enabled": false,
  "python.testing.pytestArgs": [
    "tests/unit_test",
    "tests/integration_test"
  ],
  "chat.tools.terminal.autoApprove": {
    "/^uv run ruff check --fix \\.\\\\src\\\\pywandahydra\\\\scenarios\\\\excel\\\\cases\\.py; uv run ruff check \\.\\\\src\\\\pywandahydra\\\\scenarios; uv run mypy src/pywandahydra/scenarios; uv run python -c \"import pywandahydra\\.scenarios\"$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^uv run pytest -o addopts='' tests/ -q$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^uv run mypy src/pywandahydra$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^uv run ruff check src tests examples$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^uv run ruff check --fix src tests examples$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^uv run ruff check src tests examples; uv run mypy src/pywandahydra$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^uv run pytest -o addopts='' tests/ -q --junit-xml=pytest_report\\.xml$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^uv run ruff check src/pywandahydra -q; uv run mypy src/pywandahydra$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^uv run mypy src/pywandahydra/scenarios$/": {
      "approve": true,
      "matchCommandLine": true
    },
    "/^uv run ruff check src\\\\pywandahydra\\\\config src\\\\pywandahydra\\\\run\\.py src\\\\pywandahydra\\\\execution\\\\plans\\.py$/": {
      "approve": true,
      "matchCommandLine": true
    }
  }
}